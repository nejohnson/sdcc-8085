# SVN metadata — kept on disk so `svn update`/`svn diff` still work, but not tracked by git.
.svn/

# --- Object files & libtool/autotools build artifacts ---
*.o
*.obj
*.lo
*.la
*.a
*.exe
*.dll
.deps/
.libs/
.dirstamp

# --- Autotools / configure generated (these are NOT tracked in the SVN baseline) ---
config.log
config.status
config.cache
autom4te.cache/
/sdcc/sdccconf.h
/sdcc/sdcc_vc.h

# --- Python bytecode ---
*.pyc
__pycache__/

# --- SDCC device-library build output tree ---
/sdcc/device/lib/build/

# --- device-library & assembler build artifacts ---
# (*.rel/*.sym/*.lst have no tracked files; safe to ignore globally.)
*.rel
*.sym
*.lst
*.adb
*.cdb
*.dump
*.hex
# Compiler-generated .asm from the device-library build. Hand-written library
# .asm and regression/sdas .asm fixtures live elsewhere and stay tracked
# (git-ignore never untracks an already-tracked file).
/sdcc/device/lib/**/*.asm
# sdas per-assembler object directories
obj/

# --- configure/make generated files (not in the SVN baseline) ---
# (git-ignore only affects untracked files, so the SVN-tracked Makefiles under
#  sdcc-build/ and sdcc-cf/ stay tracked; only generated ones are ignored.)
Makefile
Makefile.dep
Makefile.depcc
Makefile.depcxx
Makefile.common
main.mk
ports.all
ports.build
packages.mk
common.mk
serdep.tmp
ddconfig.h
*.rul

# generated lexers/parsers
/sdcc/src/SDCClex.c
/sdcc/src/SDCCy.c
/sdcc/src/SDCCy.h
/sdcc/src/version.h
/sdcc/sim/ucsim/src/core/cmd.src/cmdlex.cc
/sdcc/sim/ucsim/src/core/cmd.src/cmdpars.cc
/sdcc/sim/ucsim/src/core/cmd.src/cmdpars.hh

# built tools land in sdcc/bin/ (tracked files there are only *.in and README)
/sdcc/bin/*
!/sdcc/bin/*.in
!/sdcc/bin/README
/sdcc/src/sdcc

# ucsim simulator binaries
ucsim_*

# generated regression host spec (from spec.mk.in)
/sdcc/support/regression/ports/host/spec.mk

# generated config headers
/sdcc/debugger/mcs51/config.h
/sdcc/support/packihx/config.h

# --- vendored build trees: support/cpp (gcc preprocessor) & support/sdbinutils ---
# All of the following are autotools/gcc/binutils build artifacts. (git-ignore
# only affects untracked files, so tracked upstream sources are unaffected.)
config.h
config.lt
confdefs.h
auto-host.h
bconfig.h
bversion.h
configargs.h
cs-bconfig.h
cs-config.h
gcc-driver-name.h
multilib.h
omp-device-properties.h
plugin-version.h
specs.h
options.h
options.cc
options-save.cc
all-tree.def
pass-instances.def
version.h
localedir.h
localedir.hs
gstdint.h
backtrace-supported.h
bfd.h
bfd-in3.h
bfdver.h
elf32-target.h
elf64-target.h
targmatch.h
sysroff.h
sysinfo.h
libtool
libtool-soversion
ofiles
option-includes.mk
optionlist
Make-hooks
.gdbinit
install-debuginfo-for-buildid.sh
stamp-h
stamp-h1
stamp-ofiles
stamp-lib
stamp-noasandir
stamp-picdir
cstamp-h
s-alltree
s-bversion
s-mlib
s-omp-device-properties-h
s-options
s-options-h
s-specs
s-version
stmp-bfd-h
**/po/Makefile.in
**/po/BLD-POTFILES
**/po/SRC-POTFILES
**/po/POTFILES
# generated binutils lexers/parsers
/sdcc/support/sdbinutils/binutils/arlex.c
/sdcc/support/sdbinutils/binutils/arparse.c
/sdcc/support/sdbinutils/binutils/arparse.h
/sdcc/support/sdbinutils/binutils/defparse.c
/sdcc/support/sdbinutils/binutils/defparse.h
/sdcc/support/sdbinutils/binutils/mcparse.c
/sdcc/support/sdbinutils/binutils/mcparse.h
/sdcc/support/sdbinutils/binutils/rcparse.c
/sdcc/support/sdbinutils/binutils/rcparse.h
/sdcc/support/sdbinutils/binutils/syslex.c
/sdcc/support/sdbinutils/binutils/sysinfo.c
# generated executables in the vendored trees
/sdcc/support/cpp/gcc/build/
/sdcc/support/cpp/gcc/as
/sdcc/support/cpp/gcc/cc1
/sdcc/support/cpp/gcc/cpp
/sdcc/support/cpp/gcc/nm
/sdcc/support/cpp/gcc/collect-ld
/sdcc/support/cpp/gcc/dsymutil
/sdcc/support/sdbinutils/binutils/bfdtest1
/sdcc/support/sdbinutils/binutils/bfdtest2
/sdcc/support/sdbinutils/binutils/cxxfilt
/sdcc/support/sdbinutils/binutils/sdar
/sdcc/support/sdbinutils/binutils/sdnm
/sdcc/support/sdbinutils/binutils/sdobjcopy
/sdcc/support/sdbinutils/binutils/sdranlib
/sdcc/support/sdbinutils/binutils/sysinfo

# NOTE: intentionally NOT ignoring *.asm, *.ihx, *.rel, *.lst, *.lib, *.rst, Makefile —
# the SVN baseline tracks such files as test fixtures / generated-but-committed sources.
# git-ignore only affects untracked files, so build outputs with these names in
# throwaway build dirs are handled by the directory rules above.
