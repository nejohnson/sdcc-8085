// peeph-i8085.def - Intel-syntax peephole rules for the i8080/i8085 ports.
//
// This is the active default rule set (options.nopeep = 0 in main.c) -
// every rule group below landed incrementally, each validated
// individually before being folded in (hand-reasoning against the 8085
// data sheet, a real-corpus scan with --peep-file to find genuine
// firing instances, and a ucsim behavioral check).
//
// Phase-1 (groups 1-7, task #17): dead-load/dead-result elimination and
// straight-line arithmetic/move simplifications - none of it touches
// control flow.
//
// Phase-2 (task #20, starting with group 8): control-flow rules -
// jmp/call/ret. peeph.def's own z80-family equivalents split cleanly
// into two classes once checked against this hardware: rules that
// genuinely port (this hardware has jmp/j<cc>/call/ret/r<cc>, all
// absolute, exactly like z80's jp/jp <cc>/call/ret/ret <cc> - only the
// mnemonic spelling differs) are ported below, group by group. Rules
// that convert an absolute jump to a *relative* one (peeph.def's 162/
// 162a/163) or fold "dec b"/"jr nz" into djnz (peeph.def's 167) are not
// deferred - they are permanently inapplicable, full stop: 8080/8085
// has no relative jump and no djnz instruction at all, not even as an
// undocumented opcode (unlike some of the actual undocumented
// instructions this port's --allow-undocumented-instructions does
// support), so there is no future version of this port that could ever
// use them.
//
// Group 1: dead-load / dead-result elimination. Ported from peeph.def's
// peephole 0a/158 (redundant self-move), 2b (dead 16-bit add result),
// 2d (dead accumulator-rotate result), 6b (dead 8-bit ALU result), and
// 6c (dead comparison result).

// common peephole 0a/158: "mov %1, %1" is always a no-op (copying a
// register into itself, never affecting flags), so it can simply be
// deleted regardless of whether the result is used afterward.
replace restart {
	mov	%1, %1
} by {
	; dead self-move %1, %1 removed
} if notVolatile(%1)

// common peephole 2b: dad's result (the new hl) and its only flag effect
// (cy - see peep.c's surelyWritesFlag()) can both be proven dead; ac/n/
// p/s/z are not part of dad's effect at all (8085 data sheet), so they
// are not queried here.
replace restart {
	dad	%1
} by {
	; dead dad %1 removed: hl result and carry both unused
} if notUsed('hl'), notUsed('cf')

// common peephole 2d: the accumulator-only rotates rlc/rrc/ral/rar (bare
// form, no operand slot, so this can never accidentally match a
// per-register rotate of the same mnemonic elsewhere). All four only
// ever affect cy.
replace restart {
	%1
} by {
	; dead %1 removed: accumulator result and carry both unused
} if same(%1 'rlc' 'rrc' 'ral' 'rar'), notUsed('a'), notUsed('cf')

// common peephole 6b: add/adc/sub/sbb/ana/xra/ora (register/M form) and
// adi/aci/sui/sbi/ani/ori/xri (immediate form) are both single-operand
// with an implicit accumulator destination (see gen.c's
// emit_A_ARITH8()), so one match pattern covers both. cmp/cpi are
// deliberately excluded here -
// they never write a at all, so their dead-result condition is different
// (see the next rule) - and notUsed('af') covers both the accumulator
// result and every flag these eight always redefine (peep.c's
// surelyWritesFlag()).
replace restart {
	%1	%2
} by {
	; dead %1 %2 removed: accumulator result and flags unused
} if same(%1 'add' 'adc' 'sub' 'sbb' 'ana' 'xra' 'ora' 'adi' 'aci' 'sui' 'sbi' 'ani' 'ori' 'xri'), notUsed('af')

// common peephole 6c: cmp/cpi never write a - only flags - so unlike
// the rule above this only needs notUsed('f'), not notUsed('af').
replace restart {
	%1	%2
} by {
	; dead %1 %2 removed: comparison result (flags) unused
} if same(%1 'cmp' 'cpi'), notUsed('f')

// A note on notVolatile() used throughout the rest of this file: the
// shared, cross-port notVolatileVariable() in SDCCpeeph.c recognizes
// indirect-addressing operand text ("(hl)", "(bc)", "(de)", ...) to decide whether an
// operand denotes a possibly-volatile memory access; anything without
// an underscore-prefixed symbol name that doesn't match one of those
// literal substrings - which includes every Intel-syntax memory operand
// this port ever produces ("m", or ldax/stax's bare pair-selector "b"/
// "d"/"h") - falls through to its "found no symbol name, so it can't be
// volatile" default and returns true unconditionally, regardless of
// whether the access is genuinely volatile. notVolatile(%N) is
// therefore only trustworthy here when %N is a plain register (a/b/c/
// d/e/h/l) - never "m" or a pair-selector - which every use of it below
// is careful to guarantee, either by construction (the operand can only
// ever be a register in that position) or explicit exclusion. Wherever
// this file needs to protect an actual memory access, it uses bare
// notVolatile (no parameter), which scans the underlying iCodes
// directly rather than pattern-matching operand text, and is unaffected
// by this gap. Not something this port's own peep.c can fix (this
// function lives in the shared core, not per-port code) - flagged, not
// fixed here.

// Group 2: register-to-register mov loads. Ported from peeph.def's
// peephole 22a: a value is moved into a register purely to feed the
// very next 8-bit ALU op, and that register is never used again - fold
// the move into the ALU op's operand directly. notSame(%2 'a') is
// essential, not optional: if %2 were "a" itself, "%3 %2" is really
// "%3 a", a *self-referential* op whose result depends on the value mov
// just wrote into a (e.g. "mov a, m" / "ora a" - a self-or, always equal
// to whatever mov loaded, regardless of a's previous contents). Folding
// that into "%3 %1" (e.g. "ora m") instead computes old-a OP %1 - a
// completely different, wrong result, since it now depends on a's
// *previous* value instead. %2 is otherwise always a plain register
// (never "m") by construction - it must be a valid mov destination the
// *previous* line assigned it, and, since %3 %2 requires %2 to also be
// an arith8 operand, in practice always is one. canAssign(%1 'b')
// confirms %1 itself is assignable into a plain register, i.e. a valid
// arith8 register/M operand, before folding it into %1's place.
replace restart {
	mov	%2, %1
	%3	%2
} by {
	%3	%1
} if notUsed(%2), notSame(%1 'a'), notSame(%2 'a'), same(%3 'add' 'adc' 'sub' 'sbb' 'ana' 'xra' 'ora' 'cmp'), canAssign(%1 'b'), notVolatile

// Group 3: immediate loads. Ported from peeph.def's peephole 92a/92b/
// 92c/93a/93b/93c: two separate 8-bit immediate loads that together
// build up a 16-bit register pair get combined into one 16-bit
// immediate load. 92*/93* differ only in which of the two registers is
// the pair's high vs. low half (canJoinRegs(hi lo dst) - see its own
// doc comment in peep.c); 92b/92c/93b/93c are the "xra a" zero-idiom
// variant (SDCC often builds a zero byte this way instead of "mvi r,
// #0"), needing the extra notUsed('a' 'cf' 'zf') to confirm the
// xra's own effects are also safely subsumed by the combined load.

replace {
	mvi	%5, #%1
	mvi	%6, #%2
} by {
	; combined immediate loads into %7 (low=%5=#%1, high=%6=#%2)
	lxi	%7, #%4
} if canJoinRegs(%6 %5 %7), operandsLiteral(%1 %2), immdInRange(0x00 0xffff '*' %2 0x100 %3), immdInRange(0x00 0xffff '|' %3 %1 %x4)

replace {
	mvi	%5, #%1
	mvi	%6, #%2
} by {
	; combined immediate loads into %7 (high=%5=#%1, low=%6=#%2)
	lxi	%7, #%4
} if canJoinRegs(%5 %6 %7), operandsLiteral(%1 %2), immdInRange(0x00 0xffff '*' %1 0x100 %3), immdInRange(0x00 0xffff '|' %3 %2 %x4)

replace {
	xra	a
	mov	%5, a
	mvi	%6, #%2
} by {
	; combined immediate loads into %7 (low=%5=zero, high=%6=#%2)
	lxi	%7, #%4
} if canJoinRegs(%6 %5 %7), operandsLiteral(%2), immdInRange(0x00 0xffff '*' %2 0x100 %x4), notUsed('a' 'cf' 'zf')

replace {
	xra	a
	mvi	%5, #%1
	mov	%6, a
} by {
	; combined immediate loads into %7 (low=%5=#%1, high=%6=zero)
	lxi	%7, #%1
} if canJoinRegs(%6 %5 %7), operandsLiteral(%1), notUsed('a' 'cf' 'zf')

replace {
	xra	a
	mov	%5, a
	mvi	%6, #%2
} by {
	; combined immediate loads into %7 (high=%5=zero, low=%6=#%2)
	lxi	%7, #%2
} if canJoinRegs(%5 %6 %7), operandsLiteral(%2), notUsed('a' 'cf' 'zf')

replace {
	xra	a
	mvi	%5, #%1
	mov	%6, a
} by {
	; combined immediate loads into %7 (high=%5=#%1, low=%6=zero)
	lxi	%7, #%4
} if canJoinRegs(%5 %6 %7), operandsLiteral(%1), immdInRange(0x00 0xffff '*' %1 0x100 %x4), notUsed('a' 'cf' 'zf')

// Group 4: direct-address (lda/sta/lhld/shld). Ported from peeph.def's
// peephole 17/18/19/20: hl is loaded with a constant address purely to
// read or write one byte through it, and hl itself is never used
// afterward - use lda/sta directly on that address instead. Two match
// variants each (lxi hl vs. lxi h) since gen.c emits either spelling of
// the same pair operand interchangeably depending on call site (see
// peep.c's intelPairOperand() comment).
replace restart {
	lxi	hl, #%1
	mov	a, m
} by {
	; loaded %1 into a directly instead of through hl
	lda	%1
} if notUsed('hl')

replace restart {
	lxi	h, #%1
	mov	a, m
} by {
	; loaded %1 into a directly instead of through hl
	lda	%1
} if notUsed('hl')

replace restart {
	lxi	hl, #%1 + %2
	mov	a, m
} by {
	; loaded %1+%2 into a directly instead of through hl
	lda	%1 + %2
} if notUsed('hl')

replace restart {
	lxi	hl, #%1
	mov	m, a
} by {
	; stored a to %1 directly instead of through hl
	sta	%1
} if notUsed('hl')

replace restart {
	lxi	h, #%1
	mov	m, a
} by {
	; stored a to %1 directly instead of through hl
	sta	%1
} if notUsed('hl')

replace restart {
	lxi	hl, #%1 + %2
	mov	m, a
} by {
	; stored a to %1+%2 directly instead of through hl
	sta	%1 + %2
} if notUsed('hl')

// Group 5: indirect (ldax/stax). ldax always loads straight into a (see
// gen.c's emit_A_LD()'s LDF_LDAX case) - there is no intermediate
// register for a "forward through" rule the way group 2's plain mov
// case has, so the one clean, safe rule here mirrors group 1's dead-dad
// rule: a load through bc/de whose result in a is never used at all can
// simply be dropped. Guarded by bare notVolatile (not notVolatile(%1),
// which - per this file's notVolatile() note above - cannot correctly
// tell whether the memory pointed to by bc/de is volatile from "b"/"d"
// alone): a genuinely volatile memory-mapped read must still happen for
// its side effect even when the value it produces goes unused.
replace restart {
	ldax	%1
} by {
	; dead ldax %1 removed: accumulator result unused
} if notUsed('a'), notVolatile

// Group 6: push/pop. Ported from peeph.def's peephole 50a/50b - neither
// rule's correctness depends on what's inside the pushed/popped pair,
// only on the net stack-pointer and register effect, which is
// unconditionally a no-op in the push/pop order and conditionally so -
// notUsed(%1) - in the pop/push order. No volatility guard needed:
// push/pop always address the stack via sp, never a general (possibly
// memory-mapped) operand.
replace restart {
	pop	%1
	push	%1
} by {
	; dead pop/push %1 pair removed: popped value unused
} if notUsed(%1)

replace restart {
	push	%1
	pop	%1
} by {
	; dead push/pop %1 pair removed: no-op round trip
}

// Group 7: add hl,rr (i.e. dad, when its result *is* used - group 1
// only covered the dead-result case). Ported from peeph.def's peephole
// 119 and 120, both exploiting addition's commutativity to avoid a
// redundant register copy or to fold two additions' constants together
// at assemble time.
replace restart {
	mov	c, l
	mov	b, h
	lxi	h, #%1
	dad	b
} by {
	; loaded #%1 into bc directly instead of copying hl there first
	lxi	b, #%1
	dad	b
} if notUsed('bc')

replace restart {
	lxi	h, #%1
	dad	%2
	lxi	b, #%4
	dad	b
} by {
	; combined the two constant additions to hl into one
	lxi	h, #%1 + %4
	dad	%2
} if notUsed('bc')

// Group 8 (task #20): call-then-return at the end of a function is a
// tail call - the callee's own ret will return straight to whoever
// called this function, so there is no need to return here first and
// call again. Ported directly from peeph.def's common peephole 135;
// call/ret/jmp are identical mnemonics and semantics on 8080/8085 (all
// absolute, no relative-addressing distinction to worry about, unlike
// the jp->jr rules this port can never port - see this file's header),
// so only the Zilog "jp" -> Intel "jmp" mnemonic rename was needed.
// symmParmStack() (SDCCpeeph.c, cross-port, already available) checks
// that the callee itself pops its own parameters (K&R/__z88dk_fastcall-
// style, not caller-pops-cdecl) - otherwise replacing call+ret with a
// plain jmp would leave the caller's parameters permanently on the
// stack once the callee returns.
replace restart {
	call	%1
	ret
} by {
	; task #20 replaced call+ret at function end by a tail-call jmp
	jmp	%1
} if symmParmStack(%1)

// Group 9 (task #20): an unconditional jump whose only possible target
// is an immediate return can just return directly - one instruction
// instead of two, and it may drop the target label's last remaining
// reference (labelRefCountChange, needed so later rules - notably
// Group 11's unused-label removal - see an accurate count afterward).
// Ported from peeph.def's common peephole 160.
//
// Deliberately NOT ported here: peephole 161's conditional counterpart
// (jz/jnz/jc/jnc/jm/jp/jpo/jpe -> rz/rnz/rc/rnc/rm/rp/rpo/rpe). Unlike
// bare "ret" - already fully wired through every classifier in this
// file (mightRead/mightReadFlag/etc.), since gen.c has always emitted
// it - the 8 conditional-return mnemonics have never appeared in this
// port's output before. A sanity check while drafting this group
// (comparing --no-peep output against a real jz-to-return-only-label
// case) surfaced "Warning: mightReadFlag unknown asm inst line: rnz" -
// mightReadFlag()'s existing "ret" case checks for Zilog's two-token
// "ret\t<cc>" form (dead syntax this port never emits, same as the
// jp/jr-with-comma checks nearby), not Intel's fused rz/rnz/etc., and
// there is no isIntelCondRet() counterpart to isIntelCondJump() (used
// throughout this file, ~7 call sites) at all. A conditional return is
// a genuine hybrid, not a drop-in analog of either bare ret or a
// conditional jump: like a conditional jump it reads exactly the one
// flag its condition tests and, if not taken, falls through; like ret
// it also reads the return-value registers/sp when taken. Getting
// every affected classifier right needs its own careful, dedicated
// pass (own task, not squeezed into this checkpoint) - see the project
// status memory doc.
replace restart {
	jmp	%5
} by {
	; task #20 replaced jump to a return-only label by a direct ret
	ret
} if labelIsReturnOnly(%5), labelRefCountChange(%5 -1)

// Group 10 (task #20): a conditional jump straight to the following
// instruction is always a no-op - taken, it lands on %5, which is
// right here anyway; not taken, execution falls through to the same
// place - so it can just be deleted. Holds regardless of the condition
// tested (a conditional jump only ever reads flags, never sets them or
// has any other side effect), and unlike Group 9's conditional-return
// question this introduces no new mnemonic into the stream at all -
// there is nothing here for peep.c's classifiers to recognize that
// they do not already. Ported from peeph.def's common peephole 164,
// which is likewise conditional-only. An unconditional-jmp variant was
// tried too and pulled: it fired zero times across the whole 6358-case
// regression corpus (as peeph.def's own scoping predicted - a bare
// unconditional jump to its own immediately-following label does not
// survive to the peephole stage on this port either), so per the
// "genuine firing required" rule it is not carried as dead weight.
// Condition set is genIfxJump()'s own complete list.
replace restart {
	jz	%5
%5:
} by {
	; task #20 removed conditional jump to the next instruction
%5:
} if labelRefCountChange(%5 -1)

replace restart {
	jnz	%5
%5:
} by {
	; task #20 removed conditional jump to the next instruction
%5:
} if labelRefCountChange(%5 -1)

replace restart {
	jc	%5
%5:
} by {
	; task #20 removed conditional jump to the next instruction
%5:
} if labelRefCountChange(%5 -1)

replace restart {
	jnc	%5
%5:
} by {
	; task #20 removed conditional jump to the next instruction
%5:
} if labelRefCountChange(%5 -1)

replace restart {
	jm	%5
%5:
} by {
	; task #20 removed conditional jump to the next instruction
%5:
} if labelRefCountChange(%5 -1)

replace restart {
	jp	%5
%5:
} by {
	; task #20 removed conditional jump to the next instruction
%5:
} if labelRefCountChange(%5 -1)

replace restart {
	jpo	%5
%5:
} by {
	; task #20 removed conditional jump to the next instruction
%5:
} if labelRefCountChange(%5 -1)

replace restart {
	jpe	%5
%5:
} by {
	; task #20 removed conditional jump to the next instruction
%5:
} if labelRefCountChange(%5 -1)

// Group 11 (task #20, phase-2 begins): unused-label removal. Ported
// directly from peeph.def's common peephole 159 - a label with zero
// references left anywhere in the function is simply dead, regardless
// of mnemonic syntax on either side of it, so this rule needs no
// Intel-vs-Zilog adaptation at all. Placed last in the file (as
// peeph.def's own comment on 159 says its ancestor should be: "opens
// the code to further peephole optimization") so it can catch labels
// any future phase-2 group above frees up (e.g. a jmp-to-ret rewrite
// dropping a jump target's last remaining reference), not just labels
// already unused before any rule in this file ever runs.
replace restart {
%1:
} by {
	; task #20 removed unused label %1
} if labelRefCount(%1 0)
