VPATH  = @srcdir@
srcdir = @srcdir@

GROFF  = @GROFF@
MMROFF = @MMROFF@

include ../Makefile.common

MANUAL = sdccman

# The manual is groff -mm, with tbl tables and pic figures.  sdcc-version
# is the version on the title page.
GROFFFLAGS = -t -p -mm -dsdcc-version=$(VERSION)

all: $(MANUAL).pdf $(MANUAL).html/index.html $(MANUAL).txt

install:
	$(INSTALL) -d $(DESTDIR)$(docdir)
	cp -rf $(srcdir)/*.txt $(DESTDIR)$(docdir)
	if [ -f $(MANUAL).txt             ]; then cp -f  $(MANUAL).txt  $(DESTDIR)$(docdir); fi
	if [ -f $(MANUAL).html/index.html ]; then cp -rf $(MANUAL).html $(DESTDIR)$(docdir); fi
	if [ -f $(MANUAL).pdf             ]; then cp -rf $(MANUAL).pdf  $(DESTDIR)$(docdir); fi

uninstall:
	rm -rf $(DESTDIR)$(docdir)

# Each output is set in two passes.  The first (mmroff -x) writes the
# cross-references to $(MANUAL).qrf and the raw index to $(MANUAL).ind,
# and mkindex.awk makes the index proper, $(MANUAL).idx, from the raw one.
# The second pass sets the document.  Page numbers differ from device to
# device, so each output has its own first pass; they share the files, so
# they are made one at a time.
.NOTPARALLEL:

# $(call first-pass,device options)
define first-pass
	$(MMROFF) -x $(GROFFFLAGS) $(1) $<
	$(AWK) -f $(srcdir)/mkindex.awk $(MANUAL).ind | LC_ALL=C sort | \
	  $(AWK) -f $(srcdir)/mkindex.awk -v pass=2 > $(MANUAL).idx
endef

PDFFLAGS = -Tpdf -P-pa4

$(MANUAL).pdf: $(MANUAL).mm mkindex.awk
	$(call first-pass,$(PDFFLAGS))
	$(GROFF) $(GROFFFLAGS) $(PDFFLAGS) $< > $@

# -c and friends:  plain text, without terminal escapes or overstriking.
$(MANUAL).txt: $(MANUAL).mm mkindex.awk
	$(call first-pass,-Tutf8)
	$(GROFF) $(GROFFFLAGS) -Tutf8 -P-cbou $< > $@

# One HTML file per chapter, with the tables and figures as images.  The
# second pass runs in the HTML directory, where it finds its own copy of
# the first pass's files.
$(MANUAL).html/index.html: $(MANUAL).mm mkindex.awk
	$(call first-pass,-Thtml)
	rm -rf $(MANUAL).html
	mkdir $(MANUAL).html
	cp $(MANUAL).qrf $(MANUAL).idx $(MANUAL).html
	cd $(MANUAL).html && \
	  $(GROFF) $(GROFFFLAGS) -Thtml -P-j$(MANUAL) -P-I$(MANUAL) -P-Dimages -P-b \
	    $(abspath $<) > index.html
	rm -f $(MANUAL).html/$(MANUAL).qrf $(MANUAL).html/$(MANUAL).idx

archive: all
	rm -rf sdcc-doc sdcc-doc.tar.bz2
	mkdir sdcc-doc
	rsync -rCt *.pdf *.txt $(srcdir)/*.txt sdcc-doc

	for doc in $(MANUAL); do \
	  rsync -Rt $$doc.html/*.html $$doc.html/images/*.png sdcc-doc/; \
	done

	mkdir sdcc-doc/as
	rsync -rCt $(top_srcdir)/../vendor/asxxxx/asxdoc/* sdcc-doc/as/

	mkdir sdcc-doc/ucsim
	cd $(top_srcdir)/sim/ucsim/doc; rsync *.html *.jpg *.fig ../../../doc/sdcc-doc/ucsim/

	tar -c sdcc-doc | bzip2 -9 > sdcc-doc.tar.bz2

include $(srcdir)/clean.mk
