# libc/i8085-undoc Makefile
#
# Identical to the i8085 library but built with the undocumented 8085
# instructions and flags enabled (--allow-undocumented-instructions). The
# driver selects this variant when the user enables undocumented instructions.
# crt0.s is shared from ../i8085 via VPATH.

VPATH  = @srcdir@
srcdir = @srcdir@
top_builddir = @top_builddir@
abs_top_builddir = @abs_top_builddir@

LIB_TYPE     = @LIB_TYPE@

EXTRA_CFLAGS = -mi8085 --allow-undocumented-instructions --max-allocs-per-node 25000
SAS = $(top_builddir)/bin/sdasz80

# override PORTDIR defined by super (parent) makefile
override PORTDIR = ../build/i8085-undoc

%.rel: %.s
	@# TODO: sdas should place it\'s output in the current dir
	test $(srcdir) = . || cp $< .
	-$(AS) $(ASFLAGS) $(notdir $<)
	test $(srcdir) = . || rm $(notdir $<)

include $(srcdir)/../incl.mk

I8085_FLOAT = $(COMMON_FLOAT)

I8085_LONG = $(COMMON_LONG) \
  _divulong.c \
  _mullong.c

I8085_LONGLONG = $(COMMON_LONGLONG) \
  _mullonglong.c \
  _divslonglong.c \
  _divulonglong.c \
  _modslonglong.c \
  _modulonglong.c

I8085_SUPPORT = \
  _mulint.c _mulschar.c _muluchar.c \
  _divsint.c _divuint.c _divschar.c _divuchar.c \
  _modsint.c _moduint.c _modschar.c _moduchar.c \
  memcpy.c _memmove.c _strcpy.c strlen.c \
  __itoa.c __ltoa.c

I8085_SDCC = $(COMMON_SDCC) \
  _startup.c \
  div.c \
  ldiv.c \
  lldiv.c \
  sprintf.c \
  vprintf.c \
  strnlen.c \
  _strcmp.c \
  atomic_flag_clear.c

I8085SOURCES = $(addprefix ../,$(I8085_FLOAT) $(I8085_LONG) $(I8085_LONGLONG) $(I8085_SUPPORT) $(I8085_SDCC))
I8085OBJECTS = $(patsubst %.c,%.rel,$(I8085_FLOAT) $(I8085_LONG) $(I8085_LONGLONG) $(I8085_SUPPORT) $(I8085_SDCC))

LIB = i8085.lib
AS = $(SAS)
ASFLAGS = -plosgff

CFLAGS = -I$(srcdir)/../../include -I. --std-c23

all: $(PORTDIR)/$(LIB) $(PORTDIR)/crt0.rel

$(PORTDIR)/crt0.rel: crt0.rel
	cp crt0.rel $(PORTDIR)/crt0.rel

$(PORTDIR)/$(LIB): $(I8085OBJECTS) Makefile
	rm -f $@
ifeq ($(LIB_TYPE), SDCCLIB)
	$(top_builddir)/bin/sdcclib -a $@ $(I8085OBJECTS)
else
  ifeq ($(LIB_TYPE), AR)
	$(SDAR) -rcSD $@ $(I8085OBJECTS)
  else
    ifeq ($(LIB_TYPE), RANLIB)
	$(SDAR) -rcD $@ $(I8085OBJECTS)
    else
	for i in $(basename $(I8085OBJECTS)); do echo $$i >>$@; done
	cp $(I8085OBJECTS) $(PORTDIR)
    endif
  endif
endif

clean:
	rm -f *.rel *.sym *.lst *~ $(CLEANSPEC) *.dump* *.asm *.lib

distclean: clean
	rm -f Makefile

Makefile: $(srcdir)/Makefile.in
	cd $(top_builddir); ./config.status device/lib/i8085-undoc/Makefile
