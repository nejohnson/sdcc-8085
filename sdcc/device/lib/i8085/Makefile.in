# libc/i8085 Makefile
#
# The 8080/8085 library is built entirely from the portable C sources (no
# hand-written z80 assembly), plus an 8080-clean crt0. The integer mul/div/mod
# support routines, memcpy/strcpy etc. that the z80 port supplies as optimised
# assembly are taken from their C equivalents here.

VPATH  = @srcdir@
srcdir = @srcdir@
top_builddir = @top_builddir@
abs_top_builddir = @abs_top_builddir@

# i8085 links via vendor's own aslink now, not sdldz80 (src/i8085/main.c,
# _i8085VendorLinkCmdMacro) - so this port's library must be in vendor's own
# native library format: a plain-text list of relative .rel filenames (one
# per line, no archive wrapper), read directly by linksrc/lklibr.c's
# fndsym(). The top-level configured default (@LIB_TYPE@, normally RANLIB -
# a real GNU-ar-format archive via sdar) is intentionally NOT used here: it
# would produce a library vendor's aslink can't open at all. Any value other
# than SDCCLIB/AR/RANLIB below falls into the existing plain-list branch,
# which already produces exactly this format (also used as-is by
# support/regression/fwk/lib/fwk.lib, an existing precedent for the same
# format) - no other i8085 target depends on i8085.lib's format, so nothing
# else is affected by pinning it here.
LIB_TYPE     = ASXVENDOR

EXTRA_CFLAGS = -mi8085 --max-allocs-per-node 25000
SAS = $(top_builddir)/bin/asz80

# override PORTDIR defined by super (parent) makefile
override PORTDIR = ../build/i8085

%.rel: %.s
	@# TODO: sdas should place it\'s output in the current dir
	test $(srcdir) = . || cp $< .
	-$(AS) $(ASFLAGS) $(notdir $<)
	test $(srcdir) = . || rm $(notdir $<)

include $(srcdir)/../incl.mk

I8085_FLOAT = $(COMMON_FLOAT)

I8085_LONG = $(COMMON_LONG) \
  _divulong.c \
  _mullong.c

I8085_LONGLONG = $(COMMON_LONGLONG) \
  _mullonglong.c \
  _divslonglong.c \
  _divulonglong.c \
  _modslonglong.c \
  _modulonglong.c

# Integer mul/div/mod and mem/str support routines the z80 port keeps in
# hand-written assembly; use the portable C versions on the 8080/8085.
I8085_SUPPORT = \
  _mulint.c _mulschar.c _muluchar.c \
  __muluint2ulong.c __mulsint2slong.c \
  _divsint.c _divuint.c _divschar.c _divuchar.c \
  _modsint.c _moduint.c _modschar.c _moduchar.c \
  memcpy.c __memcpy.c _memmove.c _strcpy.c strlen.c \
  __itoa.c __ltoa.c

I8085_SDCC = $(COMMON_SDCC) \
  _startup.c \
  div.c \
  ldiv.c \
  lldiv.c \
  sprintf.c \
  vprintf.c \
  strnlen.c \
  _strcmp.c \
  atomic_flag_clear.c

# Hand-written 8080/8085 assembler routines that live in this port directory:
#   heap.s   - the _HEAP storage + heap-init hook required by malloc/free/etc.
#   setjmp.s - setjmp/longjmp (no frame pointer, so jmp_buf is 4 bytes)
I8085_ASMOBJ = heap.rel setjmp.rel __sdcc_call_hl.rel __builtin_memcpy.rel atomic_flag_test_and_set.rel

I8085SOURCES = $(addprefix ../,$(I8085_FLOAT) $(I8085_LONG) $(I8085_LONGLONG) $(I8085_SUPPORT) $(I8085_SDCC))
I8085OBJECTS = $(patsubst %.c,%.rel,$(I8085_FLOAT) $(I8085_LONG) $(I8085_LONGLONG) $(I8085_SUPPORT) $(I8085_SDCC)) $(I8085_ASMOBJ)

LIB = i8085.lib
AS = $(SAS)
# Matches port->assembler.plain_opts ("-plosgffw") in src/i8085/main.c's
# i8085_port - kept consistent since both invoke the same vendor asz80.
ASFLAGS = -plosgffw

CFLAGS = -I$(srcdir)/../../include -I. --std-c23

all: $(PORTDIR)/$(LIB) $(PORTDIR)/crt0.rel

$(PORTDIR)/crt0.rel: crt0.rel
	cp crt0.rel $(PORTDIR)/crt0.rel

$(PORTDIR)/$(LIB): $(I8085OBJECTS) Makefile
	rm -f $@
ifeq ($(LIB_TYPE), SDCCLIB)
	$(top_builddir)/bin/sdcclib -a $@ $(I8085OBJECTS)
else
  ifeq ($(LIB_TYPE), AR)
	$(SDAR) -rcSD $@ $(I8085OBJECTS)
  else
    ifeq ($(LIB_TYPE), RANLIB)
	$(SDAR) -rcD $@ $(I8085OBJECTS)
    else
	for i in $(basename $(I8085OBJECTS)); do echo $$i >>$@; done
	cp $(I8085OBJECTS) $(PORTDIR)
    endif
  endif
endif

clean:
	rm -f *.rel *.sym *.lst *~ $(CLEANSPEC) *.dump* *.asm *.lib

distclean: clean
	rm -f Makefile

Makefile: $(srcdir)/Makefile.in
	cd $(top_builddir); ./config.status device/lib/i8085/Makefile
