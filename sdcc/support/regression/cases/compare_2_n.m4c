/** Compare with 2^n greater then 255
    test for patch #2702889 - Summary of all uncommitted changes I applied on "my" SDCC
*/

#include <testfwk.h>


int
lwr_if_0x0080 (unsigned left)
{ 
  if (left < 0x0080)
    return 1;
  else
    return 0;
}

int
lwr_0x0080 (unsigned left)
{
  return left < 0x0080;
}

void
test_lwr_0x0080 (void)
{
#if !defined(__SDCC_pdk14) && !defined(__SDCC_pdk15) // Lack of memory
  ASSERT (lwr_if_0x0080 (0x0080 - 1));
  ASSERT (!lwr_if_0x0080 (0x0080));
  ASSERT (!lwr_if_0x0080 (0x0080 + 1));

  ASSERT (lwr_0x0080 (0x0080 - 1));
  ASSERT (!lwr_0x0080 (0x0080));
  ASSERT (!lwr_0x0080 (0x0080 + 1));
#endif
}

